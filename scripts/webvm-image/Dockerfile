FROM alpine:3.19

RUN apk add --no-cache bash coreutils less nano figlet libstdc++ \
    && adduser -D -s /bin/bash user \
    && echo 'user:user' | chpasswd \
    && mkdir -p /home/user \
    && chown user:user /home/user

# Generated by generate-content.mjs from config.json — portfolio content
# (banner/about/projects/whoami) as real commands in the real shell.
COPY rootfs-overlay/ /
RUN chmod +x /usr/local/bin/banner /usr/local/bin/about /usr/local/bin/projects \
      /usr/local/bin/repo /usr/local/bin/whoami /usr/local/bin/help \
    # bash's `help` builtin shadows /usr/local/bin/help, so the banner's
    # "Type 'help'" would print bash's builtin index instead of the site's.
    && echo "enable -n help" >> /etc/profile \
    && echo "[ -t 0 ] && banner" >> /etc/profile \
    # Portfolio content is read-only, scratch/ is the one carve-out. Rule, not a
    # per-file list, so new content from config.json can't drift out of sync.
    # Files stay root-owned on purpose: uid 1000 could chmod +w its own files
    # and undo this. /home/user itself stays user-owned so the shell feels
    # normal (which does leave `rm -f` possible — this is a guardrail, and
    # nothing is at risk: every write is local to the visitor's own browser).
    && chown -R root:root /home/user && chmod -R a-w /home/user \
    && chown user:user /home/user && chmod 755 /home/user \
    && chown -R user:user /home/user/scratch && chmod 755 /home/user/scratch \
    && chmod 644 /home/user/scratch/*

# PokéMUD: on $PATH but absent from `help`, so it rewards poking around.
# The binary is committed prebuilt: the source is still live CSE240 coursework
# and must not be published. Rebuild (source stays local, gitignored) with:
#   docker run --rm --platform linux/i386 -v "$PWD/pokemud:/src" -w /src alpine:3.19 \
#     sh -c 'apk add g++ && g++ -Wall -std=c++17 -o pokemud.bin *.cpp pokemud/*.cpp && strip pokemud.bin'
# Same alpine:3.19 as below, so it links the libstdc++ this image ships. Keep it
# dynamic: -static gives a static-PIE that CheerpX faults on before main().
COPY pokemud/pokemud.bin pokemud/rooms.json pokemud/items.json pokemud/pokemon.json \
      pokemud/moves.json pokemud/team.json /usr/local/share/pokemud/
COPY pokemud/pokemud.sh /usr/local/bin/pokemud
# The JSON arrived from the course box mode 755; it is data, not programs.
RUN chmod +x /usr/local/bin/pokemud \
    && chmod 644 /usr/local/share/pokemud/*.json

WORKDIR /home/user
