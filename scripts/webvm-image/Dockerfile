FROM alpine:3.19

RUN apk add --no-cache bash coreutils less nano figlet \
    && adduser -D -s /bin/bash user \
    && echo 'user:user' | chpasswd \
    && mkdir -p /home/user \
    && chown user:user /home/user

# Generated by generate-content.mjs from config.json — portfolio content
# (banner/about/projects/whoami) as real commands in the real shell.
COPY rootfs-overlay/ /
RUN chmod +x /usr/local/bin/banner /usr/local/bin/about /usr/local/bin/projects \
      /usr/local/bin/repo /usr/local/bin/whoami /usr/local/bin/help \
    && echo "[ -t 0 ] && banner" >> /etc/profile \
    # COPY lands the home-directory files as root; the VM runs as uid 1000.
    && chown -R user:user /home/user

WORKDIR /home/user
